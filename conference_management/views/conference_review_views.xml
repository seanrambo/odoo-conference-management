<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="conference_review_view_list" model="ir.ui.view">
        <field name="name">conference.review.list</field>
        <field name="model">conference.review</field>
        <field name="arch" type="xml">
            <list string="Reviews" create="false" decoration-muted="state == 'declined'">
                <field name="submission_reference" string="Ref."/>
                <field name="submission_name"/>
                <field name="event_id" optional="show"/>
                <field name="reviewer_id" optional="show"/>
                <field name="score" widget="float" digits="[3, 2]"/>
                <field name="recommendation"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'assigned'"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
            </list>
        </field>
    </record>

    <record id="conference_review_view_form" model="ir.ui.view">
        <field name="name">conference.review.form</field>
        <field name="model">conference.review</field>
        <field name="arch" type="xml">
            <form string="Review" create="false">
                <header>
                    <button name="action_submit_review" type="object" string="Submit Review" class="btn-primary"
                            invisible="state != 'assigned'"/>
                    <button name="action_decline" type="object" string="Decline"
                            invisible="state != 'assigned'"
                            confirm="Decline this review? The organizers will assign someone else."/>
                    <button name="action_reopen" type="object" string="Reopen"
                            invisible="state == 'assigned'" groups="event.group_event_user"/>
                    <field name="state" widget="statusbar" statusbar_visible="assigned,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <field name="submission_reference" class="text-muted"/>
                        <h1><field name="submission_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="event_id" readonly="1"/>
                            <field name="author_display" readonly="1"/>
                            <field name="submission_type" readonly="1"/>
                            <field name="submission_keywords" readonly="1"/>
                        </group>
                        <group>
                            <field name="reviewer_id" readonly="1"/>
                            <field name="submission_state" readonly="1"/>
                            <field name="date_done" invisible="not date_done"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Abstract and Files" name="paper">
                            <field name="submission_abstract" readonly="1"/>
                            <separator string="Files"/>
                            <field name="submission_document_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="document_type"/>
                                    <field name="file" filename="filename" widget="binary"/>
                                    <field name="filename" column_invisible="1"/>
                                    <field name="version"/>
                                </list>
                            </field>
                        </page>
                        <page string="My Assessment" name="assessment">
                            <group>
                                <group string="Scores (1 to 5)">
                                    <field name="score_originality" widget="radio" options="{'horizontal': true}" readonly="state != 'assigned'"/>
                                    <field name="score_relevance" widget="radio" options="{'horizontal': true}" readonly="state != 'assigned'"/>
                                    <field name="score_clarity" widget="radio" options="{'horizontal': true}" readonly="state != 'assigned'"/>
                                    <field name="score_quality" widget="radio" options="{'horizontal': true}" readonly="state != 'assigned'"/>
                                    <field name="score" widget="float" digits="[3, 2]"/>
                                </group>
                                <group string="Recommendation">
                                    <field name="recommendation" widget="radio" readonly="state != 'assigned'"/>
                                    <field name="conflict_of_interest" readonly="state != 'assigned'"/>
                                </group>
                            </group>
                            <group>
                                <field name="comment_author" readonly="state != 'assigned'"
                                       placeholder="Constructive feedback. This is sent to the author."/>
                                <field name="comment_committee" readonly="state != 'assigned'"
                                       placeholder="Confidential notes for the programme committee."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="conference_review_view_search" model="ir.ui.view">
        <field name="name">conference.review.search</field>
        <field name="model">conference.review</field>
        <field name="arch" type="xml">
            <search string="Reviews">
                <field name="submission_name"/>
                <field name="reviewer_id"/>
                <field name="event_id"/>
                <filter name="to_review" string="To Review" domain="[('state', '=', 'assigned')]"/>
                <filter name="done" string="Completed" domain="[('state', '=', 'done')]"/>
                <filter name="mine" string="My Reviews" domain="[('reviewer_id', '=', uid)]"/>
                <separator/>
                <filter name="group_reviewer" string="Reviewer" context="{'group_by': 'reviewer_id'}"/>
                <filter name="group_event" string="Event" context="{'group_by': 'event_id'}"/>
            </search>
        </field>
    </record>

    <record id="conference_review_action_mine" model="ir.actions.act_window">
        <field name="name">My Reviews</field>
        <field name="res_model">conference.review</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('reviewer_id', '=', uid)]</field>
        <field name="context">{'search_default_to_review': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing to review right now</p>
            <p>Submissions assigned to you will appear here.</p>
        </field>
    </record>

    <record id="conference_review_action" model="ir.actions.act_window">
        <field name="name">All Reviews</field>
        <field name="res_model">conference.review</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_reviewer': 1}</field>
    </record>
</odoo>
