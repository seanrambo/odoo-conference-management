<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="conference_submission_view_list" model="ir.ui.view">
        <field name="name">conference.submission.list</field>
        <field name="model">conference.submission</field>
        <field name="arch" type="xml">
            <list string="Submissions" default_order="average_score desc, submit_date desc">
                <field name="reference"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="event_id" optional="show"/>
                <field name="submission_type"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="hide"/>
                <field name="submit_date" optional="show"/>
                <field name="review_done_count" string="Reviews Done"/>
                <field name="review_count" string="Reviewers"/>
                <field name="average_score" widget="float" digits="[3, 2]"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('submitted', 'under_review')"
                       decoration-warning="state == 'revision'"
                       decoration-success="state == 'accepted'"
                       decoration-danger="state == 'rejected'"
                       decoration-muted="state in ('draft', 'withdrawn')"/>
            </list>
        </field>
    </record>

    <record id="conference_submission_view_kanban" model="ir.ui.view">
        <field name="name">conference.submission.kanban</field>
        <field name="model">conference.submission</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" highlight_color="color" quick_create="false" group_create="false" group_delete="false" records_draggable="false">
                <templates>
                    <t t-name="menu">
                        <t t-if="widget.editable"><a role="menuitem" type="open" class="dropdown-item">Edit</a></t>
                        <field name="color" widget="kanban_color_picker"/>
                    </t>
                    <t t-name="card">
                        <field name="reference" class="text-muted small"/>
                        <field name="name" class="fw-medium fs-5"/>
                        <field name="partner_id" class="small"/>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        <footer class="pt-1">
                            <div class="d-flex align-items-center small text-muted">
                                <span><field name="review_done_count"/>/<field name="review_count"/> reviews</span>
                                <span class="ms-2" t-if="record.review_done_count.raw_value">
                                    <i class="fa fa-star text-warning" title="Average score"/> <field name="average_score" widget="float" digits="[3, 2]"/>
                                </span>
                            </div>
                            <div class="ms-auto">
                                <field name="activity_ids" widget="kanban_activity"/>
                            </div>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="conference_submission_view_form" model="ir.ui.view">
        <field name="name">conference.submission.form</field>
        <field name="model">conference.submission</field>
        <field name="arch" type="xml">
            <form string="Submission">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary"
                            invisible="state not in ('draft', 'revision')"/>
                    <button name="action_auto_assign_reviewers" type="object" string="Auto-assign Reviewers"
                            class="btn-primary" invisible="state not in ('submitted', 'under_review')"/>
                    <button name="action_start_review" type="object" string="Start Review"
                            invisible="state != 'submitted'"/>
                    <button name="action_accept" type="object" string="Accept" class="btn-success"
                            invisible="state not in ('submitted', 'under_review')"
                            confirm="Accept this submission? The author is emailed and a session is created on the agenda."/>
                    <button name="action_request_revision" type="object" string="Request Revision"
                            invisible="state not in ('submitted', 'under_review')"
                            confirm="Ask the author for a revision? They are emailed with the reviewer comments."/>
                    <button name="action_reject" type="object" string="Reject" class="btn-danger"
                            invisible="state not in ('submitted', 'under_review')"
                            confirm="Reject this submission? The author is emailed with the reviewer comments."/>
                    <button name="action_withdraw" type="object" string="Withdraw"
                            invisible="state in ('accepted', 'rejected', 'withdrawn')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('rejected', 'withdrawn')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,under_review,accepted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-file-o">
                            <field name="document_count" string="Files" widget="statinfo"/>
                        </button>
                        <button name="action_view_track" type="object" class="oe_stat_button" icon="fa-microphone"
                                invisible="not track_id" string="Session"/>
                    </div>
                    <div class="oe_title">
                        <field name="reference" class="text-muted"/>
                        <h1><field name="name" placeholder="e.g. Scaling M-Pesa payments for SMEs"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="event_id" readonly="state not in ('draft',)"/>
                            <field name="partner_id" readonly="state not in ('draft',)"/>
                            <field name="partner_email" widget="email"/>
                            <field name="coauthors" placeholder="One per line, with affiliation"/>
                        </group>
                        <group>
                            <field name="submission_type"/>
                            <field name="duration" widget="float_time"/>
                            <field name="keywords"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/>
                            <field name="submit_date"/>
                            <field name="average_score" invisible="not review_done_count" widget="float" digits="[3, 2]"/>
                            <field name="review_done_count" invisible="1"/>
                            <field name="track_id" invisible="not track_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Abstract" name="abstract">
                            <field name="abstract" placeholder="What is the talk about, and what will attendees learn?"/>
                        </page>
                        <page string="Reviews" name="reviews">
                            <field name="review_ids" context="{'default_submission_id': id}"
                                   readonly="state not in ('submitted', 'under_review')">
                                <list editable="bottom" decoration-muted="state == 'declined'">
                                    <field name="reviewer_id"/>
                                    <field name="state" readonly="1" widget="badge"
                                           decoration-success="state == 'done'" decoration-info="state == 'assigned'"/>
                                    <field name="score_originality" readonly="1" optional="hide"/>
                                    <field name="score_relevance" readonly="1" optional="hide"/>
                                    <field name="score_clarity" readonly="1" optional="hide"/>
                                    <field name="score_quality" readonly="1" optional="hide"/>
                                    <field name="score" readonly="1"/>
                                    <field name="recommendation" readonly="1"/>
                                    <field name="comment_committee" readonly="1" optional="show"/>
                                    <field name="comment_author" readonly="1" optional="hide"/>
                                    <field name="conflict_of_interest" readonly="1" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Decision" name="decision">
                            <group>
                                <field name="decision_note" placeholder="Optional personal message added to the decision email, above the reviewer comments."/>
                                <field name="decision_date"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="conference_submission_view_search" model="ir.ui.view">
        <field name="name">conference.submission.search</field>
        <field name="model">conference.submission</field>
        <field name="arch" type="xml">
            <search string="Submissions">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('reference', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="event_id"/>
                <field name="keywords"/>
                <field name="tag_ids"/>
                <filter name="to_decide" string="To Decide" domain="[('state', 'in', ('submitted', 'under_review'))]"/>
                <filter name="has_reviews" string="Has Completed Reviews"
                        domain="[('review_done_count', '>', 0)]"/>
                <filter name="accepted" string="Accepted" domain="[('state', '=', 'accepted')]"/>
                <filter name="revision" string="Revision Requested" domain="[('state', '=', 'revision')]"/>
                <separator/>
                <filter name="group_event" string="Event" context="{'group_by': 'event_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_type" string="Session Type" context="{'group_by': 'submission_type'}"/>
            </search>
        </field>
    </record>

    <record id="conference_submission_action" model="ir.actions.act_window">
        <field name="name">Submissions</field>
        <field name="res_model">conference.submission</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No submissions yet</p>
            <p>Turn on "Call for Papers" on an event. Authors then submit from the event website or their portal.</p>
        </field>
    </record>
</odoo>
