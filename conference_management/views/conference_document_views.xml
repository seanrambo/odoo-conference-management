<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="conference_document_view_list" model="ir.ui.view">
        <field name="name">conference.document.list</field>
        <field name="model">conference.document</field>
        <field name="arch" type="xml">
            <list string="Documents" decoration-muted="state == 'rejected'">
                <header>
                    <button name="action_approve" type="object" string="Approve"/>
                    <button name="action_reset_pending" type="object" string="Back to Pending"/>
                </header>
                <field name="name"/>
                <field name="document_type"/>
                <field name="event_id" optional="show"/>
                <field name="track_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="location_id" optional="show"/>
                <field name="date_start" optional="show"/>
                <field name="file" filename="filename" widget="binary" optional="show"/>
                <field name="filename" column_invisible="1"/>
                <field name="file_size_display" string="Size" optional="show"/>
                <field name="version" optional="hide"/>
                <field name="visibility" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'"
                       decoration-warning="state == 'pending'" decoration-danger="state == 'rejected'"/>
                <field name="uploaded_via_portal" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="conference_document_view_form" model="ir.ui.view">
        <field name="name">conference.document.form</field>
        <field name="model">conference.document</field>
        <field name="arch" type="xml">
            <form string="Document">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state == 'approved'"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state == 'rejected'"
                            confirm="Reject this file? The owner is emailed the rejection reason."/>
                    <button name="action_reset_pending" type="object" string="Back to Pending"
                            invisible="state == 'pending'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Keynote slides"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="event_id"/>
                            <field name="document_type"/>
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                            <field name="file_size_display" string="Size" invisible="not file"/>
                            <field name="version" invisible="version == 1"/>
                            <field name="visibility" widget="radio"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="track_id"/>
                            <field name="submission_id"/>
                            <field name="registration_id"/>
                            <field name="location_id" invisible="not location_id"/>
                            <field name="date_start" invisible="not date_start"/>
                            <field name="uploaded_via_portal" invisible="not uploaded_via_portal"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Optional notes about this file"/>
                        <field name="rejection_reason" invisible="state == 'approved'"
                               placeholder="Required to reject. Sent to the owner, e.g. 'Please use the 16:9 conference template.'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="conference_document_view_kanban" model="ir.ui.view">
        <field name="name">conference.document.kanban</field>
        <field name="model">conference.document</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" records_draggable="false">
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-medium"/>
                        <div class="small text-muted">
                            <field name="document_type"/> · <field name="file_size_display"/>
                        </div>
                        <field name="track_id" class="small"/>
                        <footer class="pt-1 small text-muted">
                            <field name="partner_id"/>
                            <field name="visibility" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="conference_document_view_search" model="ir.ui.view">
        <field name="name">conference.document.search</field>
        <field name="model">conference.document</field>
        <field name="arch" type="xml">
            <search string="Documents">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('filename', 'ilike', self)]"/>
                <field name="event_id"/>
                <field name="track_id"/>
                <field name="partner_id"/>
                <field name="location_id"/>
                <filter name="pending" string="Pending Approval" domain="[('state', '=', 'pending')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <separator/>
                <filter name="slides" string="Slides" domain="[('document_type', '=', 'slides')]"/>
                <filter name="unscheduled" string="Not Linked to a Session" domain="[('track_id', '=', False)]"/>
                <filter name="portal" string="Uploaded via Portal" domain="[('uploaded_via_portal', '=', True)]"/>
                <separator/>
                <filter name="group_event" string="Event" context="{'group_by': 'event_id'}"/>
                <filter name="group_room" string="Room" context="{'group_by': 'location_id'}"/>
                <filter name="group_type" string="Type" context="{'group_by': 'document_type'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="conference_document_action" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">conference.document</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No files yet</p>
            <p>Upload slides, papers and handouts here, or let speakers and attendees upload from their portal.</p>
        </field>
    </record>
</odoo>
