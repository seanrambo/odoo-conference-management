<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_submission_received" model="mail.template">
        <field name="name">Conference: submission received</field>
        <field name="model_id" ref="model_conference_submission"/>
        <field name="subject">Submission received: {{ object.reference }} - {{ object.event_id.name }}</field>
        <field name="email_from">{{ (object.event_id.organizer_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
<div style="margin: 0; padding: 0; font-size: 14px;">
    <p>Dear <t t-out="object.partner_id.name or ''">Author</t>,</p>
    <p>Thank you for your submission to <strong t-out="object.event_id.name or ''">the conference</strong>.</p>
    <table style="border-collapse: collapse; margin: 16px 0;">
        <tr><td style="padding: 4px 16px 4px 0; color: #6b6b6b;">Reference</td><td style="padding: 4px 0;"><strong t-out="object.reference or ''">CFP26-0001</strong></td></tr>
        <tr><td style="padding: 4px 16px 4px 0; color: #6b6b6b;">Title</td><td style="padding: 4px 0;" t-out="object.name or ''">Title</td></tr>
    </table>
    <p>The programme committee will review it and you will hear from us by email. You can follow its status at any time:</p>
    <p><a t-att-href="object.get_base_url() + object.get_portal_url()" style="background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #ffffff; border-radius: 5px; font-size: 13px;">View my submission</a></p>
</div>
        </field>
    </record>

    <record id="mail_template_submission_accepted" model="mail.template">
        <field name="name">Conference: submission accepted</field>
        <field name="model_id" ref="model_conference_submission"/>
        <field name="subject">Accepted: {{ object.name }} - {{ object.event_id.name }}</field>
        <field name="email_from">{{ (object.event_id.organizer_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
<div style="margin: 0; padding: 0; font-size: 14px;">
    <p>Dear <t t-out="object.partner_id.name or ''">Author</t>,</p>
    <p>We are pleased to tell you that <strong t-out="object.name or ''">your submission</strong> (<t t-out="object.reference or ''"/>) has been <strong>accepted</strong> for <t t-out="object.event_id.name or ''">the conference</t>.</p>
    <p t-if="object.decision_note" style="white-space: pre-wrap;" t-out="object.decision_note or ''"/>
    <t t-set="feedback" t-value="object._get_author_feedback()"/>
    <t t-if="feedback">
        <p><strong>Reviewer comments</strong></p>
        <t t-foreach="feedback" t-as="comment">
            <p style="white-space: pre-wrap; border-left: 3px solid #dddddd; padding-left: 8px; color: #444444;" t-out="comment"/>
        </t>
    </t>
    <p>Please upload your presentation slides from your portal before the upload deadline<t t-if="object.event_id.doc_upload_deadline"> (<t t-out="format_datetime(object.event_id.doc_upload_deadline, tz=object.event_id.date_tz, dt_format='medium')"/>)</t>.</p>
    <p><a t-att-href="object.get_base_url() + '/my/conference/documents'" style="background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #ffffff; border-radius: 5px; font-size: 13px;">Upload my slides</a></p>
</div>
        </field>
    </record>

    <record id="mail_template_submission_rejected" model="mail.template">
        <field name="name">Conference: submission not accepted</field>
        <field name="model_id" ref="model_conference_submission"/>
        <field name="subject">Decision on your submission: {{ object.name }}</field>
        <field name="email_from">{{ (object.event_id.organizer_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
<div style="margin: 0; padding: 0; font-size: 14px;">
    <p>Dear <t t-out="object.partner_id.name or ''">Author</t>,</p>
    <p>Thank you for submitting <strong t-out="object.name or ''">your work</strong> (<t t-out="object.reference or ''"/>) to <t t-out="object.event_id.name or ''">the conference</t>. After careful review, the committee was unable to accept it this time.</p>
    <p t-if="object.decision_note" style="white-space: pre-wrap;" t-out="object.decision_note or ''"/>
    <t t-set="feedback" t-value="object._get_author_feedback()"/>
    <t t-if="feedback">
        <p><strong>Reviewer comments</strong></p>
        <t t-foreach="feedback" t-as="comment">
            <p style="white-space: pre-wrap; border-left: 3px solid #dddddd; padding-left: 8px; color: #444444;" t-out="comment"/>
        </t>
    </t>
    <p>We hope to see you at the event, and we encourage you to submit again in the future.</p>
</div>
        </field>
    </record>

    <record id="mail_template_submission_revision" model="mail.template">
        <field name="name">Conference: revision requested</field>
        <field name="model_id" ref="model_conference_submission"/>
        <field name="subject">Revision requested: {{ object.name }}</field>
        <field name="email_from">{{ (object.event_id.organizer_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
<div style="margin: 0; padding: 0; font-size: 14px;">
    <p>Dear <t t-out="object.partner_id.name or ''">Author</t>,</p>
    <p>The committee has reviewed <strong t-out="object.name or ''">your submission</strong> (<t t-out="object.reference or ''"/>) and asks for a <strong>revision</strong> before making a final decision.</p>
    <p t-if="object.decision_note" style="white-space: pre-wrap;" t-out="object.decision_note or ''"/>
    <t t-set="feedback" t-value="object._get_author_feedback()"/>
    <t t-if="feedback">
        <p><strong>Reviewer comments</strong></p>
        <t t-foreach="feedback" t-as="comment">
            <p style="white-space: pre-wrap; border-left: 3px solid #dddddd; padding-left: 8px; color: #444444;" t-out="comment"/>
        </t>
    </t>
    <p>Please update your abstract or upload a revised file, then submit again.</p>
    <p><a t-att-href="object.get_base_url() + object.get_portal_url()" style="background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #ffffff; border-radius: 5px; font-size: 13px;">Revise my submission</a></p>
</div>
        </field>
    </record>

    <record id="mail_template_document_rejected" model="mail.template">
        <field name="name">Conference: document needs changes</field>
        <field name="model_id" ref="model_conference_document"/>
        <field name="subject">Please update your file: {{ object.name }}</field>
        <field name="email_from">{{ (object.event_id.organizer_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
<div style="margin: 0; padding: 0; font-size: 14px;">
    <p>Hello <t t-out="object.partner_id.name or ''">there</t>,</p>
    <p>The organizers of <t t-out="object.event_id.name or ''">the event</t> could not approve your file <strong t-out="object.filename or object.name or ''">slides.pptx</strong>.</p>
    <p style="white-space: pre-wrap; border-left: 3px solid #dddddd; padding-left: 8px;" t-out="object.rejection_reason or ''">Reason</p>
    <p>Please upload a corrected version from your portal.</p>
    <p><a t-att-href="object.get_base_url() + '/my/conference/documents'" style="background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #ffffff; border-radius: 5px; font-size: 13px;">My conference files</a></p>
</div>
        </field>
    </record>
</odoo>
