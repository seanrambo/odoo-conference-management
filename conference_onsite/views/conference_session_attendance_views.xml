<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="conference_session_attendance_view_list" model="ir.ui.view">
        <field name="name">conference.session.attendance.list</field>
        <field name="model">conference.session.attendance</field>
        <field name="arch" type="xml">
            <list string="Session Attendance" create="0" sample="1">
                <field name="scan_date"/>
                <field name="registration_id"/>
                <field name="email" optional="hide"/>
                <field name="track_id"/>
                <field name="location_id" optional="show"/>
                <field name="event_id" column_invisible="context.get('default_event_id')" optional="show"/>
                <field name="method" optional="show"/>
                <field name="override_reason" optional="show" widget="badge" decoration-warning="override_reason"/>
                <field name="cpd_points" optional="hide" sum="Total"/>
                <field name="user_id" optional="hide" widget="many2one_avatar_user"/>
                <field name="company_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="conference_session_attendance_view_form" model="ir.ui.view">
        <field name="name">conference.session.attendance.form</field>
        <field name="model">conference.session.attendance</field>
        <field name="arch" type="xml">
            <form string="Session Attendance">
                <sheet>
                    <group>
                        <group>
                            <field name="track_id" options="{'no_create': True}"/>
                            <field name="event_id" invisible="1"/>
                            <field name="registration_id" options="{'no_create': True}"
                                   domain="[('event_id', '=', event_id), ('state', 'in', ('open', 'done'))]"/>
                            <field name="location_id"/>
                        </group>
                        <group>
                            <field name="scan_date"/>
                            <field name="method"/>
                            <field name="cpd_points"/>
                            <field name="override_reason" invisible="not override_reason"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="conference_session_attendance_view_search" model="ir.ui.view">
        <field name="name">conference.session.attendance.search</field>
        <field name="model">conference.session.attendance</field>
        <field name="arch" type="xml">
            <search string="Session Attendance">
                <field name="registration_id" string="Attendee"
                       filter_domain="['|', ('registration_id.name', 'ilike', self), ('registration_id.email', 'ilike', self)]"/>
                <field name="track_id"/>
                <field name="location_id"/>
                <field name="event_id"/>
                <filter string="Today" name="today"
                        domain="[('scan_date', '&gt;=', (context_today()).strftime('%Y-%m-%d 00:00:00')), ('scan_date', '&lt;=', (context_today()).strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="Overrides" name="overrides" domain="[('override_reason', '!=', False)]"/>
                <filter string="Manual" name="manual" domain="[('method', '=', 'manual')]"/>
                <separator/>
                <filter string="Scan Date" name="filter_scan_date" date="scan_date"/>
                <group>
                    <filter string="Session" name="group_by_track" context="{'group_by': 'track_id'}"/>
                    <filter string="Room" name="group_by_location" context="{'group_by': 'location_id'}"/>
                    <filter string="Event" name="group_by_event" context="{'group_by': 'event_id'}"/>
                    <filter string="Hour" name="group_by_hour" context="{'group_by': 'scan_date:hour'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="conference_session_attendance_view_pivot" model="ir.ui.view">
        <field name="name">conference.session.attendance.pivot</field>
        <field name="model">conference.session.attendance</field>
        <field name="arch" type="xml">
            <pivot string="Session Attendance" sample="1">
                <field name="track_id" type="row"/>
                <field name="scan_date" interval="day" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="conference_session_attendance_view_graph" model="ir.ui.view">
        <field name="name">conference.session.attendance.graph</field>
        <field name="model">conference.session.attendance</field>
        <field name="arch" type="xml">
            <graph string="Session Attendance" type="bar" sample="1">
                <field name="track_id"/>
            </graph>
        </field>
    </record>

    <record id="conference_session_attendance_action" model="ir.actions.act_window">
        <field name="name">Session Attendance</field>
        <field name="res_model">conference.session.attendance</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No one has been scanned into a session yet</p>
            <p>Open an event and press <strong>Session Scanner</strong>. Door staff pick the session and scan
               badges with a phone camera or a USB scanner.</p>
        </field>
    </record>
</odoo>
