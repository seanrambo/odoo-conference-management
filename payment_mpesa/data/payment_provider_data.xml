<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="payment_provider_mpesa" model="payment.provider">
        <field name="name">M-Pesa</field>
        <field name="code">mpesa</field>
        <field name="state">disabled</field>
        <field name="image_128" type="base64" file="payment_mpesa/static/description/icon.png"/>
        <field name="module_id" ref="base.module_payment_mpesa"/>
        <field name="inline_form_view_id" ref="inline_form"/>
        <field name="allow_tokenization">False</field>
        <field name="available_country_ids" eval="[Command.set([ref('base.ke')])]"/>
        <field name="available_currency_ids" eval="[Command.set([ref('base.KES')])]"/>
        <field name="payment_method_ids" eval="[Command.set([ref('payment.payment_method_mpesa')])]"/>
        <field name="pre_msg" type="html"><p>Pay with M-Pesa. You will receive a prompt on your phone.</p></field>
        <field name="pending_msg" type="html"><p>Check your phone and enter your M-Pesa PIN. This page updates once Safaricom confirms the payment.</p></field>
    </record>
</odoo>
