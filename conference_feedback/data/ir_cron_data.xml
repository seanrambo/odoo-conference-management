<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_session_feedback" model="ir.cron">
        <field name="name">Conference: ask attendees to rate sessions</field>
        <field name="model_id" ref="model_conference_session_feedback"/>
        <field name="state">code</field>
        <field name="code">model._cron_request_feedback()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="ir_cron_post_event" model="ir.cron">
        <field name="name">Conference: send event surveys and issue certificates</field>
        <field name="model_id" ref="event.model_event_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_post_event()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>
</odoo>
