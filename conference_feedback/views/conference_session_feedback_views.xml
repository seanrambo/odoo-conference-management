<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="conference_session_feedback_view_list" model="ir.ui.view">
        <field name="name">conference.session.feedback.list</field>
        <field name="model">conference.session.feedback</field>
        <field name="arch" type="xml">
            <list string="Session Feedback" create="0" sample="1">
                <field name="answer_date"/>
                <field name="track_id"/>
                <field name="speaker_id" optional="show"/>
                <field name="location_id" optional="hide"/>
                <field name="event_id" optional="hide"/>
                <field name="registration_id" optional="hide"/>
                <field name="rating" widget="priority_stars" readonly="1" avg="Average"/>
                <field name="comment" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" optional="show"/>
                <field name="company_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="conference_session_feedback_view_form" model="ir.ui.view">
        <field name="name">conference.session.feedback.form</field>
        <field name="model">conference.session.feedback</field>
        <field name="arch" type="xml">
            <form string="Session Feedback" create="0">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="track_id" readonly="1"/>
                            <field name="speaker_id"/>
                            <field name="location_id"/>
                            <field name="registration_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="rating"/>
                            <field name="answer_date"/>
                            <field name="request_sent"/>
                        </group>
                    </group>
                    <field name="comment" placeholder="No comment."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="conference_session_feedback_view_search" model="ir.ui.view">
        <field name="name">conference.session.feedback.search</field>
        <field name="model">conference.session.feedback</field>
        <field name="arch" type="xml">
            <search string="Session Feedback">
                <field name="track_id"/>
                <field name="speaker_id"/>
                <field name="event_id"/>
                <field name="comment"/>
                <filter string="Answered" name="answered" domain="[('state', '=', 'done')]"/>
                <filter string="Waiting" name="waiting" domain="[('state', '=', 'pending')]"/>
                <separator/>
                <filter string="With Comment" name="with_comment" domain="[('comment', '!=', False)]"/>
                <filter string="Low Ratings (1-2)" name="low" domain="[('state', '=', 'done'), ('rating', '&lt;=', 2)]"/>
                <group>
                    <filter string="Session" name="group_by_track" context="{'group_by': 'track_id'}"/>
                    <filter string="Speaker" name="group_by_speaker" context="{'group_by': 'speaker_id'}"/>
                    <filter string="Room" name="group_by_location" context="{'group_by': 'location_id'}"/>
                    <filter string="Event" name="group_by_event" context="{'group_by': 'event_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="conference_session_feedback_view_pivot" model="ir.ui.view">
        <field name="name">conference.session.feedback.pivot</field>
        <field name="model">conference.session.feedback</field>
        <field name="arch" type="xml">
            <pivot string="Session Feedback" sample="1">
                <field name="speaker_id" type="row"/>
                <field name="rating" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="conference_session_feedback_action" model="ir.actions.act_window">
        <field name="name">Session Feedback</field>
        <field name="res_model">conference.session.feedback</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="context">{'search_default_answered': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No ratings yet</p>
            <p>After a session ends, everyone scanned into it is emailed a link to rate it.
               Their answers appear here, by session and by speaker.</p>
        </field>
    </record>
</odoo>
