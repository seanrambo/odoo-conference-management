<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="conference_session_feedback_company_rule" model="ir.rule">
            <field name="name">Session feedback: multi-company</field>
            <field name="model_id" ref="model_conference_session_feedback"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="conference_certificate_company_rule" model="ir.rule">
            <field name="name">Certificate: multi-company</field>
            <field name="model_id" ref="model_conference_certificate"/>
